      "new": "    return plain"
    },
    {
      "label": "la pregunta sin «¿» deja de eximir",
      "old": "    return _blanked(_BARE_QUESTION, outside_opened_questions(plain))",
      "new": "    return outside_opened_questions(plain)"
    },
    {
      "label": "«adminístrelo» no se lee como administrar",
      "old": "r\"\\badministr(?:ar|e|en)\" + ATTACHED_PRONOUNS + r\"\\b\"",
      "new": "r\"\\badministr(?:ar|e|en)\\b\""
    },
    {
      "label": "«suspéndala» no se lee como orden",
      "old": "reduzca)n?\" + ATTACHED_PRONOUNS + r\"\\b\"",
