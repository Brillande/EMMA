   "new": "                     \"rules\": decided_with(None)}\n"},
  {"label": "el descarte se enseña con la version de hoy en vez de la firmada",
   "old": "        \"rules\": decided_with(item.get(RULES_VERSION_FIELD)),\n",
   "new": "        \"rules\": decided_with(rules_version()),\n"},

  {"target": "app/api/countermeasures.py",
   "label": "adoptar firma sin la version",
   "old": "            identity_for(CONSOLE_IDENTITY), rules_version=rules_version(),\n",
   "new": "            identity_for(CONSOLE_IDENTITY),\n"},
  {"target": "app/api/countermeasures.py",
   "label": "no adoptar firma sin la version",
   "old": "            identity_for(CONSOLE_IDENTITY), reason=payload.reason,\n            rules_version=rules_version(),\n",
   "new": "            identity_for(CONSOLE_IDENTITY), reason=payload.reason,\n"},
  {"target": "app/api/countermeasures.py",
   "label": "cerrar firma sin la version",
   "old": "            closed_reference_time=at_close[1] if at_close else None,\n            rules_version=rules_version(),\n",
   "new": "            closed_reference_time=at_close[1] if at_close else None,\n"},

  {"target": "app/advisor/followup.py",
   "label": "el seguimiento calla con que reglas se adopto",
   "old": "            \"adoption_rules\": decided_with(adoption.get(RULES_VERSION_FIELD)),\n",
   "new": "            \"adoption_rules\": decided_with(None),\n"},
  {"target": "app/advisor/followup.py",
   "label": "el seguimiento lee la version del cierre de la adopcion",
   "old": "                decided_with(closure.get(RULES_VERSION_FIELD)) if closure is not None else None\n",
   "new": "                decided_with(adoption.get(RULES_VERSION_FIELD)) if closure is not None else None\n"},
  {"target": "app/advisor/followup.py",
   "label": "el «no» calla con que reglas se firmo",
   "old": "        \"rules\": decided_with(decline.get(RULES_VERSION_FIELD)),\n",
   "new": "        \"rules\": decided_with(None),\n"},
  {"target": "app/api/alert_history.py",
