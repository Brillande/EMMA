          "routes_sign or adopting_closing or other_rules or recalculated"],
 "mutations": [
  {"label": "reconocer firma sin la version",
   "old": "            payload.acknowledged_by,\n            identity_for(CONSOLE_IDENTITY),\n            rules_version=rules_version(),\n",
   "new": "            payload.acknowledged_by,\n            identity_for(CONSOLE_IDENTITY),\n"},
  {"label": "declarar un estado firma sin la version",
   "old": "            payload.state, payload.note, payload.declared_by, identity_for(CONSOLE_IDENTITY),\n            rules_version=rules_version(),\n",
   "new": "            payload.state, payload.note, payload.declared_by, identity_for(CONSOLE_IDENTITY),\n"},
  {"label": "descartar firma sin la version",
   "old": "            payload.reason, payload.note, payload.declared_by, identity_for(CONSOLE_IDENTITY),\n            rules_version=rules_version(),\n",
   "new": "            payload.reason, payload.note, payload.declared_by, identity_for(CONSOLE_IDENTITY),\n"},
  {"label": "el estado dice la version de hoy en vez de la del reconocimiento firmado",
   "old": "                    decided_with(last.get(RULES_VERSION_FIELD)) if last else None\n",
   "new": "                    decided_with(rules_version()) if last else None\n"},
  {"label": "el estado calla con que reglas se declaro el estado de la alerta",
