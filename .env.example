# Configuración de EMMA. Copiar a backend/.env y ajustar.
# Todas las variables llevan el prefijo EMMA_.

# Clave de api.nasa.gov para DONKI (meteorología espacial).
# DEMO_KEY funciona pero tiene una cuota muy baja: pedir una propia gratis
# en https://api.nasa.gov/ antes del evento.
EMMA_NASA_API_KEY=DEMO_KEY

# Modo offline. En una misión real este es el modo NOMINAL de operación, no un
# modo degradado: con él activado, un dato no cacheado es un fallo explícito en
# lugar de una espera indefinida.
EMMA_OFFLINE=false

# Sin red y sin caché, usar la instantánea fechada de NASA DONKI que viaja en el
# paquete (backend/app/data/donki_snapshot.json): la consola la declara como
# «instantánea de DONKI del <fecha>, no en vivo». La aplicación de escritorio la
# enciende; nunca tapa un dato en vivo ni una caché.
EMMA_DONKI_SNAPSHOT=false

# Segundos de espera para las peticiones externas.
EMMA_REQUEST_TIMEOUT=30.0

# Observador para las efemérides de JPL Horizons (500@399 = geocentro terrestre).
# EMMA_TARGET_BODY ya no manda (2026-11-11): el cuerpo objetivo lo decide el perfil de
# misión (mars-transit y mars-surface: 499 = Marte; los demás no tienen). Si se pone
# otro valor, la consola dice que se ignora.
EMMA_TARGET_BODY=499
EMMA_OBSERVER_BODY=500@399

# Perfil de misión declarado: leo · cislunar · lunar-surface · mars-transit · mars-surface.
# Lo que dice de cada aspecto es descriptivo; lo único que decide es hacia qué cuerpo se
# calcula el tiempo de luz real que escala el riesgo. Un perfil sin ese cuerpo no consulta
# Horizons: el retardo no se calcula y el riesgo no se escala con ningún tiempo de luz.
EMMA_MISSION_PROFILE=mars-transit

# Límite de dosis efectiva de carrera, en mSv.
EMMA_CAREER_DOSE_LIMIT_MSV=600.0
